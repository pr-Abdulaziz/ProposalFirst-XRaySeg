<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-03T16:15:00.000Z" agent="Claude" version="24.7.17" type="device">
  <diagram id="f4-guided-bilayer" name="F4 Guided bilayer decoding">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="inp1" value="SAM image embedding&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;from ViT-L encoder&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="120" y="80" width="250" height="64" as="geometry"/></mxCell>
        <mxCell id="inp2" value="Sparse prompt tokens&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;derived from proposal j ∈ 𝒦&lt;sub&gt;i&lt;/sub&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="390" y="80" width="250" height="64" as="geometry"/></mxCell>

        <mxCell id="occ" value="&lt;b&gt;Occluder decoder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;predicts what lies &lt;i&gt;over&lt;/i&gt; the target&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#7B5C99;strokeWidth=3;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="120" y="192" width="520" height="70" as="geometry"/></mxCell>
        <mxCell id="ovl" value="Overlap logits&amp;nbsp; m̂&lt;sup&gt;bo&lt;/sup&gt;&lt;sub&gt;ij&lt;/sub&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="120" y="292" width="520" height="50" as="geometry"/></mxCell>

        <mxCell id="res" value="&lt;b&gt;Residual guidance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;the occluder prediction is turned into a residual image feature&lt;br&gt;and a residual prompt token that condition the second decoder&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=3;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="120" y="372" width="520" height="80" as="geometry"/></mxCell>

        <mxCell id="tgt" value="&lt;b&gt;Target (occludee) decoder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;also receives the image embedding and prompt tokens&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#7B5C99;strokeWidth=3;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="120" y="482" width="520" height="70" as="geometry"/></mxCell>
        <mxCell id="tlog" value="Target logits&amp;nbsp; m̂&lt;sub&gt;ij&lt;/sub&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="120" y="582" width="520" height="50" as="geometry"/></mxCell>

        <mxCell id="boost" value="Residual mask booster&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;8 hidden channels · strength 1.0 · learns a correction, not a replacement&lt;br&gt;&lt;i&gt;S3-MBoost and E3 only&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2.5;dashed=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="120" y="662" width="520" height="70" as="geometry"/></mxCell>

        <mxCell id="out" value="Target mask&amp;nbsp; +&amp;nbsp; overlap mask&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;512 × 512, class assigned by the Cascade head&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2.5;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="120" y="762" width="520" height="64" as="geometry"/></mxCell>

        <mxCell id="lossBox" value="" style="rounded=1;arcSize=3;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="700" y="192" width="420" height="440" as="geometry"/></mxCell>
        <mxCell id="lossT" value="Training signals" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="718" y="206" width="380" height="24" as="geometry"/></mxCell>
        <mxCell id="lossBody" value="&lt;b&gt;ℒ&lt;sub&gt;mask&lt;/sub&gt;&lt;/b&gt; — target mask cross-entropy, weight 1.0.&lt;br&gt;&lt;br&gt;&lt;b&gt;ℒ&lt;sub&gt;mask-bo&lt;/sub&gt;&lt;/b&gt; — overlap mask cross-entropy scaled by&lt;br&gt;overlap_loss_weight: &lt;b&gt;1.0&lt;/b&gt; for S2, S3-P, S3-MBoost, E3&lt;br&gt;and &lt;b&gt;0.0&lt;/b&gt; for S1 and E1, which disables the branch.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hard-aware weighting&lt;/b&gt; (E2, E3) — each instance is&lt;br&gt;reweighted by its occlusion ratio&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; r&lt;sub&gt;ij&lt;/sub&gt; = |overlap target| / |mask target| ∈ [0,1],&lt;br&gt;combined with a Dice term (1.0) and a boundary&lt;br&gt;term (0.25).&lt;br&gt;&lt;br&gt;&lt;b&gt;Difficulty-gate loss&lt;/b&gt; (E3 only) — weight 0.25." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="718" y="236" width="384" height="256" as="geometry"/></mxCell>
        <mxCell id="lossNote" value="&lt;b&gt;Supervision note.&lt;/b&gt; Target construction requires the PIXray-A field &lt;font face=&quot;Courier New&quot;&gt;bg_object_segmentation&lt;/font&gt;, so every hybrid run &lt;i&gt;loads&lt;/i&gt; overlap annotations. What separates the arms is whether that signal reaches the gradient: with weight 0 and hard-aware loss off, it does not." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="718" y="500" width="384" height="112" as="geometry"/></mxCell>

        <mxCell id="variants" value="&lt;b&gt;Which path each model uses.&lt;/b&gt;&amp;nbsp;&amp;nbsp; &lt;b&gt;S1, E1&lt;/b&gt;: target decoder only — occluder, residual guidance and booster all disabled.&amp;nbsp;&amp;nbsp; &lt;b&gt;E2&lt;/b&gt;: same forward pass as E1, hard-aware loss added.&amp;nbsp;&amp;nbsp; &lt;b&gt;S3-P&lt;/b&gt;: full occluder → residual → target chain.&amp;nbsp;&amp;nbsp; &lt;b&gt;S3-MBoost&lt;/b&gt;: S3-P plus the booster.&amp;nbsp;&amp;nbsp; &lt;b&gt;E3&lt;/b&gt;: the chain runs only for proposals the difficulty gate routes as hard (see Fig. 6)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="120" y="856" width="1000" height="72" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="inp1" target="occ"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="inp2" target="occ"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="occ" target="ovl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="ovl" target="res"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#D79B00;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="res" target="tgt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="tgt" target="tlog"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="tlog" target="boost"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="boost" target="out"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="eSkip" value="image embedding + prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.8;strokeColor=#999999;dashed=1;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontFamily=Helvetica;fontColor=#808080;labelBackgroundColor=#FFFFFF;verticalAlign=middle;horizontal=0;" edge="1" parent="1" source="inp1" target="tgt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="70" y="112"/><mxPoint x="70" y="517"/></Array></mxGeometry></mxCell>

        <mxCell id="eOvlOut" value="overlap mask" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.8;strokeColor=#D6B656;dashed=1;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontFamily=Helvetica;fontColor=#B8860B;labelBackgroundColor=#FFFFFF;horizontal=0;" edge="1" parent="1" source="ovl" target="out"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="672" y="317"/><mxPoint x="672" y="794"/></Array></mxGeometry></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
