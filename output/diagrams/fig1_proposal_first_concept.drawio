  <diagram id="f1-proposal-first-concept" name="F1 Proposal-first concept">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="frameA" value="" style="rounded=1;arcSize=4;fillColor=none;strokeColor=#B3B3B3;dashed=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="440" height="490" as="geometry"/></mxCell>
        <mxCell id="frameB" value="" style="rounded=1;arcSize=4;fillColor=none;strokeColor=#B3B3B3;dashed=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="60" width="440" height="490" as="geometry"/></mxCell>
        <mxCell id="frameC" value="" style="rounded=1;arcSize=4;fillColor=none;strokeColor=#4D4D4D;dashed=0;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1080" y="60" width="440" height="490" as="geometry"/></mxCell>

        <mxCell id="labA" value="(a) Mask-head decoding" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="440" height="26" as="geometry"/></mxCell>
        <mxCell id="labB" value="(b) Prompt-driven SAM" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="26" width="440" height="26" as="geometry"/></mxCell>
        <mxCell id="labC" value="(c) Proposal-first prompting &lt;i&gt;(ours)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1080" y="26" width="440" height="26" as="geometry"/></mxCell>

        <mxCell id="a1" value="X-ray image&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;512 × 512 × 3&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="380" height="54" as="geometry"/></mxCell>
        <mxCell id="a2" value="ResNet-101 + FPN / AttFPN&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;5 pyramid levels, 256-d&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="172" width="380" height="54" as="geometry"/></mxCell>
        <mxCell id="a3" value="RPN → 3-stage Cascade RoI&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;IoU 0.5 / 0.6 / 0.7&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="244" width="380" height="54" as="geometry"/></mxCell>
        <mxCell id="a4" value="FCN mask head&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;14 × 14 RoI  →  28 × 28 logits&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="316" width="380" height="54" as="geometry"/></mxCell>
        <mxCell id="a5" value="Target mask" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="388" width="380" height="44" as="geometry"/></mxCell>
        <mxCell id="aNote" value="&lt;b&gt;Limitation.&lt;/b&gt; Mask detail is bounded by the 28 × 28 RoI grid, and nothing in the model represents what occludes the object." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;strokeWidth=1.5;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="456" width="380" height="76" as="geometry"/></mxCell>

        <mxCell id="b1" value="X-ray image&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;512 × 512 × 3&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="590" y="100" width="380" height="54" as="geometry"/></mxCell>
        <mxCell id="b2" value="SAM ViT-L image encoder&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;frozen or LoRA-adapted&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="590" y="172" width="380" height="54" as="geometry"/></mxCell>
        <mxCell id="b3" value="Prompt: box or point&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;supplied externally&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=3;dashed=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="590" y="244" width="380" height="54" as="geometry"/></mxCell>
        <mxCell id="b4" value="SAM mask decoder" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="590" y="316" width="380" height="54" as="geometry"/></mxCell>
        <mxCell id="b5" value="Class-agnostic mask" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="590" y="388" width="380" height="44" as="geometry"/></mxCell>
        <mxCell id="bNote" value="&lt;b&gt;Limitation.&lt;/b&gt; Quality depends on a prompt the model never produces, and the output carries no class. This is not a detector." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;strokeWidth=1.5;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="590" y="456" width="380" height="76" as="geometry"/></mxCell>

        <mxCell id="c1" value="X-ray image&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;512 × 512 × 3&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="100" width="380" height="54" as="geometry"/></mxCell>
        <mxCell id="c2" value="ResNet-101 + AttFPN&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;recall RPN + 3-stage Cascade&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="172" width="380" height="54" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Proposals become the prompt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;retained set 𝒦&lt;sub&gt;i&lt;/sub&gt; → learned sparse tokens&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3B6EA5;strokeWidth=3.5;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="244" width="380" height="54" as="geometry"/></mxCell>
        <mxCell id="c4" value="SAM ViT-L + guided bilayer decoder&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;occluder → residual guidance → target&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="316" width="380" height="54" as="geometry"/></mxCell>
        <mxCell id="c5" value="Class-aware target mask &lt;b&gt;+&lt;/b&gt; overlap mask" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="388" width="380" height="44" as="geometry"/></mxCell>
        <mxCell id="cNote" value="&lt;b&gt;Idea.&lt;/b&gt; The detector supplies its own prompts, so segmentation inherits detection semantics; bilayer decoding makes occlusion explicit rather than implicit." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1110" y="456" width="380" height="76" as="geometry"/></mxCell>

