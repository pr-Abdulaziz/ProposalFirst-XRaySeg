<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-03T16:20:00.000Z" agent="Claude" version="24.7.17" type="device">
  <diagram id="f5-rpn-variants" name="F5 Proposal generation variants">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="fA" value="" style="rounded=1;arcSize=3;fillColor=none;strokeColor=#B3B3B3;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="500" height="524" as="geometry"/></mxCell>
        <mxCell id="fB" value="" style="rounded=1;arcSize=3;fillColor=none;strokeColor=#B3B3B3;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="570" y="66" width="500" height="524" as="geometry"/></mxCell>
        <mxCell id="fC" value="" style="rounded=1;arcSize=3;fillColor=none;strokeColor=#4D4D4D;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1100" y="66" width="500" height="524" as="geometry"/></mxCell>

        <mxCell id="tA" value="(a) &lt;b&gt;P2&lt;/b&gt; — standard RPN" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="32" width="500" height="26" as="geometry"/></mxCell>
        <mxCell id="tB" value="(b) &lt;b&gt;P3&lt;/b&gt; — recall-enhanced RPN" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="32" width="500" height="26" as="geometry"/></mxCell>
        <mxCell id="tC" value="(c) &lt;b&gt;P4&lt;/b&gt; — two-stage Cascade RPN" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="32" width="500" height="26" as="geometry"/></mxCell>

        <mxCell id="aAnchor" value="Anchors&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;1 scale [8] × 3 ratios [0.5, 1.0, 2.0]&lt;br&gt;strides 4 / 8 / 16 / 32 / 64&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="100" width="450" height="76" as="geometry"/></mxCell>
        <mxCell id="aMech" value="Single-stage convolutional head&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;br&gt;One 3 × 3 conv over each pyramid level predicts&lt;br&gt;objectness and box deltas directly from the&lt;br&gt;fixed anchor grid.&lt;br&gt;&lt;br&gt;No feature adaptation, no intermediate refinement.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;fontFamily=Helvetica;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="65" y="192" width="450" height="170" as="geometry"/></mxCell>
        <mxCell id="aBudget" value="Candidate budget&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;train 2000 / 2000&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;test 1000 / 1000&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=2;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="378" width="450" height="64" as="geometry"/></mxCell>
        <mxCell id="aNote" value="&lt;b&gt;Role.&lt;/b&gt; The reference proposal mechanism. Every other arm in this figure is defined as a change relative to it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1.5;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="65" y="458" width="450" height="110" as="geometry"/></mxCell>

        <mxCell id="bAnchor" value="Anchors&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;2 scales [4, 8]&lt;/b&gt; × 3 ratios [0.5, 1.0, 2.0]&lt;br&gt;strides unchanged — adds a smaller anchor&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3B6EA5;strokeWidth=3.5;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="595" y="100" width="450" height="76" as="geometry"/></mxCell>
        <mxCell id="bMech" value="Single-stage convolutional head&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;br&gt;&lt;i&gt;Identical to (a).&lt;/i&gt; The head architecture, feature&lt;br&gt;extraction and loss are untouched.&lt;br&gt;&lt;br&gt;What changes is how many candidates the anchor&lt;br&gt;grid produces and how many survive NMS.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#B3B3B3;strokeWidth=2;dashed=1;fontSize=13;fontFamily=Helvetica;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="595" y="192" width="450" height="170" as="geometry"/></mxCell>
        <mxCell id="bBudget" value="Candidate budget &lt;font color=&quot;#B85450&quot;&gt;&lt;b&gt;raised&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;train &lt;b&gt;3000 / 3000&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;test &lt;b&gt;2000 / 2000&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=3;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="595" y="378" width="450" height="64" as="geometry"/></mxCell>
        <mxCell id="bNote" value="&lt;b&gt;What it tests.&lt;/b&gt; Whether retaining more and smaller candidates raises proposal recall. Because both the anchor scale and the budget move together, P3 − P2 measures proposal &lt;i&gt;quantity&lt;/i&gt;, and recall@K must be reported next to mask AP." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#CCCCCC;strokeWidth=1.5;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="595" y="458" width="450" height="110" as="geometry"/></mxCell>

        <mxCell id="cAnchor" value="Stage 1 — anchor regression&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;1 scale [8] × &lt;b&gt;1 ratio [1.0]&lt;/b&gt; · dilated adaptive conv (d = 3)&lt;br&gt;regression only, IoU loss · RegionAssigner&lt;br&gt;centre 0.2, ignore 0.5 · bridged features&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3B6EA5;strokeWidth=3.5;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1125" y="100" width="450" height="98" as="geometry"/></mxCell>
        <mxCell id="cMech" value="Stage 2 — refine and classify&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;offset&lt;/b&gt; adaptive conv aligned to stage-1 boxes&lt;br&gt;objectness + regression · MaxIoU 0.7&lt;br&gt;256 sampled anchors, positive fraction 0.5&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3B6EA5;strokeWidth=3.5;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1125" y="240" width="450" height="98" as="geometry"/></mxCell>
        <mxCell id="cBudget" value="Candidate budget &lt;font color=&quot;#2D6A2D&quot;&gt;&lt;b&gt;held at P2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;train 2000 / 2000&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;test 1000 / 1000&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2D6A2D;strokeWidth=3;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1125" y="378" width="450" height="64" as="geometry"/></mxCell>
        <mxCell id="cNote" value="&lt;b&gt;What it tests.&lt;/b&gt; Proposal &lt;i&gt;quality&lt;/i&gt;. Because the budget is explicitly restored to P2's values after the head is replaced, any gain cannot be explained by keeping more candidates — which is exactly what separates P4 from P3." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCFCFC;strokeColor=#4D4D4D;strokeWidth=1.5;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1125" y="458" width="450" height="110" as="geometry"/></mxCell>

        <mxCell id="cArrow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#3B6EA5;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="cAnchor" target="cMech"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="aArrow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="aAnchor" target="aMech"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bArrow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#333333;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="bAnchor" target="bMech"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="strip" value="&lt;b&gt;Why both arms exist.&lt;/b&gt;&amp;nbsp;&amp;nbsp; P3 − P2 raises anchor density and the candidate budget together, so it answers &lt;i&gt;does keeping more candidates help?&lt;/i&gt;&amp;nbsp;&amp;nbsp; P4 − P2 replaces the proposal learning mechanism while holding the budget fixed, so it answers &lt;i&gt;are the candidates themselves better?&lt;/i&gt;&amp;nbsp;&amp;nbsp; Reporting P4 against P3 separates proposal quality from proposal quantity, which a single recall number cannot do." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40" y="614" width="1560" height="60" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
