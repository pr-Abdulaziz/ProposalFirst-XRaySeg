        <mxCell id="labA" value="Stage 1 — Proposal-first detector" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontFamily=Helvetica;fontColor=#3B6EA5;" vertex="1" parent="1"><mxGeometry x="50" y="62" width="500" height="24" as="geometry"/></mxCell>
        <mxCell id="labB" value="Stage 2 — Prompted SAM segmentation" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontFamily=Helvetica;fontColor=#7B5C99;" vertex="1" parent="1"><mxGeometry x="50" y="332" width="500" height="24" as="geometry"/></mxCell>
        <mxCell id="labC" value="Inactive on PIXray — PIDray-only components" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontFamily=Helvetica;fontColor=#808080;" vertex="1" parent="1"><mxGeometry x="50" y="594" width="600" height="24" as="geometry"/></mxCell>

        <mxCell id="d1" value="PIXray image&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;512 × 512 × 3&lt;br&gt;flip 0.5, resize 0.5–1.5, crop&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="195" height="86" as="geometry"/></mxCell>
        <mxCell id="d2" value="ResNet-101&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ImageNet init&lt;br&gt;C2 – C5&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="285" y="120" width="195" height="86" as="geometry"/></mxCell>
        <mxCell id="d3" value="AttFPN&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;channel + spatial selection&lt;br&gt;across 5 levels · 256-d&lt;br&gt;&lt;i&gt;P1 uses plain FPN&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="510" y="120" width="195" height="86" as="geometry"/></mxCell>
        <mxCell id="d4" value="Region proposal network&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;strides 4–64 · see Fig. 5&lt;br&gt;P2 scales[8] · P3 scales[4,8]&lt;br&gt;P4 two-stage Cascade RPN&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3B6EA5;strokeWidth=3;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="735" y="120" width="195" height="86" as="geometry"/></mxCell>
        <mxCell id="d5" value="3-stage Cascade RoI head&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;IoU 0.5 / 0.6 / 0.7&lt;br&gt;loss weights 1 / 0.5 / 0.25&lt;br&gt;RoIAlign 7 × 7&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="120" width="195" height="86" as="geometry"/></mxCell>
        <mxCell id="d6" value="Boxes + 15 classes&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;score_thr 0.05&lt;br&gt;≤ 100 detections / image&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1185" y="120" width="195" height="86" as="geometry"/></mxCell>

        <mxCell id="s1" value="Prompt generation&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;retained proposals 𝒦&lt;sub&gt;i&lt;/sub&gt; → learned&lt;br&gt;sparse tokens · 5 pts / set&lt;br&gt;prompt adapter in E1–E3&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3B6EA5;strokeWidth=3;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="285" y="390" width="195" height="86" as="geometry"/></mxCell>
        <mxCell id="s2" value="SAM ViT-L image encoder&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pretrained SAM weights&lt;br&gt;LoRA r=16 on QKV (S2)&lt;br&gt;dense image embedding&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="510" y="390" width="195" height="86" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Guided bilayer decoder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;occluder → residual guidance&lt;br&gt;→ target decoder&lt;br&gt;&lt;i&gt;detailed in Fig. 4&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#7B5C99;strokeWidth=3.5;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="735" y="390" width="195" height="86" as="geometry"/></mxCell>
        <mxCell id="s4" value="Residual mask booster&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;8 hidden channels&lt;br&gt;strength 1.0&lt;br&gt;&lt;i&gt;S3-MBoost and E3 only&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;dashed=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="390" width="195" height="86" as="geometry"/></mxCell>
        <mxCell id="s5" value="Target mask + overlap mask&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;512 × 512 per instance&lt;br&gt;class from Stage 1&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1185" y="390" width="195" height="86" as="geometry"/></mxCell>

        <mxCell id="g1" value="R&lt;sub&gt;0&lt;/sub&gt; coarse image-level node&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;loss weight 0.0 on PIXray&lt;br&gt;needs normal/empty images&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#A6A6A6;strokeWidth=2;dashed=1;fontSize=12;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="510" y="650" width="195" height="80" as="geometry"/></mxCell>
        <mxCell id="g2" value="Proposal screening g&lt;sub&gt;ij&lt;/sub&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;use_proposal_screening = False&lt;br&gt;all retained proposals decode&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#A6A6A6;strokeWidth=2;dashed=1;fontSize=12;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="735" y="650" width="195" height="80" as="geometry"/></mxCell>
        <mxCell id="gNote" value="PIXray contains no normal/empty images, so the R&lt;sub&gt;0&lt;/sub&gt; screening path carries zero loss weight and is bypassed at inference. Both blocks are retained for PIDray-30 compatibility and are drawn here only to state that they do not act on PIXray results." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="650" width="420" height="80" as="geometry"/></mxCell>

